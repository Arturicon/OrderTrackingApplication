{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=orderDb;Username=test;Password=test"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "admin",
    "Password": "admin123",
    "Port": 5672,
    "ExchangeName": "order_exchange",
    "QueueName": "order_queue",
    "RoutingKey": "order.status.changed"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SignalR": {
    "Transports": {
      "WebSockets": true,
      "ServerSentEvents": true,
      "LongPolling": false
    }
  },
  "AllowedHosts": "*",
  "ElasticSearch": {
    "Url": "http://localhost:9200",
    "Index": "myapp-logs-"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUri": "http://localhost:9200",
          "indexFormat": "myapp-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}